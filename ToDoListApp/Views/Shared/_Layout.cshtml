<!DOCTYPE html>
<html lang="tr" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ToDoListApp.styles.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #6366f1;
            --primary-light: #818cf8;
            --primary-dark: #4f46e5;
            --secondary-color: #0ea5e9;
            --light-bg: #f9fafb;
            --dark-bg: #111827;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --text-dark: #1f2937;
            --text-light: #6b7280;
            --white: #ffffff;
            --border-radius: 1rem;
            --box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: var(--light-bg);
            color: var(--text-dark);
        }

        main {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }

        .navbar {
            padding: 1rem 0;
            box-shadow: 0 1px 10px rgba(0,0,0,0.05);
            background-color: var(--white);
        }

        .navbar-brand {
            font-weight: 700;
        }

        .app-icon {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 1.2rem;
            box-shadow: 0 4px 8px rgba(99, 102, 241, 0.25);
        }

        .nav-link {
            font-weight: 500;
            color: var(--text-dark) !important;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            transition: var(--transition);
            margin: 0 0.25rem;
        }

        .nav-link:hover {
            background-color: rgba(99, 102, 241, 0.08);
            color: var(--primary-color) !important;
        }

        .nav-link.active {
            color: var(--primary-color) !important;
            font-weight: 600;
        }

        .btn {
            font-weight: 500;
            padding: 0.6rem 1.2rem;
            border-radius: 0.5rem;
            transition: var(--transition);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border: none;
            box-shadow: 0 4px 8px rgba(99, 102, 241, 0.25);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(99, 102, 241, 0.3);
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(99, 102, 241, 0.3);
        }
        
        .user-avatar-sm {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            object-fit: cover;
        }

        .dropdown-menu {
            border-radius: 0.75rem;
            border: none;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            padding: 0.75rem 0;
        }

        .dropdown-item {
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            transition: var(--transition);
        }

        .dropdown-item:hover {
            background-color: rgba(99, 102, 241, 0.08);
            color: var(--primary-color);
        }

        .footer-link {
            color: var(--text-light);
            transition: var(--transition);
            text-decoration: none;
        }

        .footer-link:hover {
            color: var(--primary-color);
        }

        .social-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: rgba(99, 102, 241, 0.1);
            color: var(--primary-color);
            transition: var(--transition);
            text-decoration: none;
        }

        .social-icon:hover {
            background-color: var(--primary-color);
            color: white;
            transform: translateY(-3px);
        }

        .container {
            max-width: 1140px;
        }

        /* Card Designs */
        .card {
            border: none;
            border-radius: var(--border-radius);
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            transition: var(--transition);
            overflow: hidden;
        }

        .card:hover {
            box-shadow: var(--box-shadow);
            transform: translateY(-5px);
        }

        .card-header {
            background-color: transparent;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 1.25rem 1.5rem;
        }

        .card-body {
            padding: 1.5rem;
        }

        /* Transitions and Animations */
        .fade-in {
            animation: fadeIn 0.5s ease-in forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide-up {
            animation: slideUp 0.5s ease-out forwards;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="app-icon">
                        <i class="bi bi-check2-all"></i>
                    </div>
                    TaskHub
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "About" ? "active" : "")" 
                               asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Hakkında
                            </a>
                        </li>
                    </ul>
                    
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserId") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Todo" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" 
                                   asp-controller="Todo" asp-action="Index">
                                    <i class="bi bi-list-check me-1"></i> Görevlerim
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Todo" && ViewContext.RouteData.Values["Action"].ToString() == "Dashboard" ? "active" : "")" 
                                   asp-controller="Todo" asp-action="Dashboard">
                                    <i class="bi bi-graph-up me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Feed" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" 
                                   asp-controller="Feed" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Topluluk
                                </a>
                            </li>
                            <li class="nav-item dropdown ms-2">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @{
                                        var user = await ViewBag.MongoDBService?.GetUserByIdAsync(Context.Session.GetString("UserId"));
                                        string profilePic = user?.ProfilePicture ?? $"https://ui-avatars.com/api/?name={Context.Session.GetString("Username")}&background=random&color=fff";
                                    }
                                    <img src="@profilePic" alt="@Context.Session.GetString("Username")" class="user-avatar me-2">
                                    <span>@Context.Session.GetString("Username")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Feed" asp-action="MyPosts">
                                            <i class="bi bi-collection me-2"></i> Paylaşımlarım
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                                </a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Kaydol
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <main role="main">
        @RenderBody()
    </main>

    <footer class="py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6 mb-3 mb-md-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="app-icon">
                            <i class="bi bi-check2-all"></i>
                        </div>
                        <h5 class="mb-0 fw-bold">TaskHub</h5>
                    </div>
                    <p class="text-muted mb-3">Görevlerinizi yönetin, hayatınızı düzenleyin ve daha verimli çalışın. TaskHub ile hedeflerinize ulaşmak artık çok daha kolay.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon">
                            <i class="bi bi-github"></i>
                        </a>
                        <a href="#" class="social-icon">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a href="#" class="social-icon">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 offset-lg-1">
                    <h6 class="fw-bold mb-3">Hızlı Linkler</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Index" class="footer-link">
                                <i class="bi bi-chevron-right me-1"></i> Ana Sayfa
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="About" class="footer-link">
                                <i class="bi bi-chevron-right me-1"></i> Hakkında
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Privacy" class="footer-link">
                                <i class="bi bi-chevron-right me-1"></i> Gizlilik
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Todo" asp-action="Index" class="footer-link">
                                <i class="bi bi-chevron-right me-1"></i> Görevlerim
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">İletişim</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="mailto:info@taskhub.com" class="footer-link">
                                <i class="bi bi-envelope me-2"></i> info@taskhub.com
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="tel:+905001112233" class="footer-link">
                                <i class="bi bi-telephone me-2"></i> +90 500 111 22 33
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="my-4">
            <div class="text-center text-muted">
                <small>&copy; @DateTime.Now.Year - TaskHub. Tüm Hakları Saklıdır.</small>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Aktif menü öğesini vurgula
        document.addEventListener('DOMContentLoaded', function() {
            const navLinks = document.querySelectorAll('.nav-link');
            const currentPath = window.location.pathname;
            
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href && currentPath.includes(href) && href !== '/') {
                    link.classList.add('active');
                } else if (href === '/' && currentPath === '/') {
                    link.classList.add('active');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
