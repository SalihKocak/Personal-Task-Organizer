@model List<Post>

@{
    ViewData["Title"] = "Paylaşımlarım";
}

<div class="bg-gradient-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h1 class="display-4 fw-bold mb-3 slide-up">Paylaşımlarım</h1>
                <p class="lead slide-up" style="animation-delay: 0.1s">
                    Oluşturduğunuz tüm paylaşımları görüntüleyin ve yönetin
                </p>
                <div class="slide-up" style="animation-delay: 0.2s">
                    <a asp-action="Create" class="btn btn-light btn-lg mt-3">
                        <i class="bi bi-plus-lg me-2"></i> Yeni Paylaşım Oluştur
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/man-sharing-updates-8017302-6456941.png" 
                     alt="Paylaşım İllüstrasyonu" class="img-fluid slide-up" style="animation-delay: 0.3s">
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var post in Model)
            {
                <div class="col-md-6 mb-4 fade-in" style="animation-delay: @(Model.IndexOf(post) * 0.1)s">
                    <div class="card h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-primary-light text-primary px-3 py-2 rounded-pill me-2">
                                    <i class="bi bi-chat-square-text me-1"></i> 
                                    Paylaşım
                                </span>
                                <span class="text-muted ms-auto small">
                                    <i class="bi bi-clock me-1"></i>
                                    @post.CreatedDate.ToString("dd MMM yyyy, HH:mm")
                                </span>
                            </div>
                            
                            <h5 class="fw-bold mb-3">@post.Title</h5>
                            <p class="text-muted mb-3">
                                @(post.Content.Length > 150 ? post.Content.Substring(0, 150) + "..." : post.Content)
                            </p>
                            
                            @if (!string.IsNullOrEmpty(post.Tags))
                            {
                                <div class="mb-4">
                                    @foreach (var tag in post.Tags.Split(','))
                                    {
                                        <span class="badge bg-primary-light text-primary me-1 mb-1 px-3 py-2 rounded-pill">
                                            <i class="bi bi-hash"></i> @tag.Trim()
                                        </span>
                                    }
                                </div>
                            }
                            
                            <div class="card-footer-actions d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-chat-dots me-1"></i> 
                                    Yorum (@(post.Comments?.Count ?? 0))
                                </a>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-primary" data-bs-toggle="tooltip" title="Görüntüle">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center mt-4">
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-2"></i> Topluluk Paylaşımlarına Dön
            </a>
        </div>
    }
    else
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <div class="icon-lg bg-primary-light text-primary mx-auto mb-4">
                    <i class="bi bi-chat-square-text"></i>
                </div>
                <h4 class="fw-bold mb-3">Henüz bir paylaşımınız yok</h4>
                <p class="text-muted mb-4">Yeni bir paylaşım oluşturmak için "Yeni Paylaşım Oluştur" butonuna tıklayabilirsiniz.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Create" class="btn btn-primary px-4">
                        <i class="bi bi-plus-lg me-1"></i> Yeni Paylaşım Oluştur
                    </a>
                    <a asp-action="Index" class="btn btn-outline-primary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Topluluk Paylaşımlarına Dön
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        }
        
        .icon-lg {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            border-radius: 24px;
            font-size: 2rem;
        }
        
        .bg-primary-light {
            background-color: rgba(99, 102, 241, 0.1);
        }
        
        .card-footer-actions {
            margin-top: auto;
        }
    </style>
}

@section Scripts {
    <script>
        // Tooltip'leri etkinleştir
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
} 