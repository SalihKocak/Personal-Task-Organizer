@model ToDoListApp.Models.Post

@{
    ViewData["Title"] = "Paylaşımı Sil";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Dikkat!</strong> Bu paylaşımı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.
                    </div>

                    <div class="mb-4">
                        <h4>@Model.Title</h4>
                        <p class="text-muted">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>
                        <p>@Model.Content</p>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">Sil</button>
                            <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 