@model Comment

<form asp-action="AddComment" method="post">
    <input type="hidden" name="PostId" value="@ViewBag.PostId" />
    <div class="mb-3">
        <label asp-for="Content" class="form-label">Yorumunuz</label>
        <textarea asp-for="Content" class="form-control" rows="3" placeholder="Bir yorum yazın..."></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-send-fill me-1"></i> Gönder
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 